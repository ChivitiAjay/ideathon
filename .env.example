# ==============================================================================
# Environment Configuration Template: Personal Gemini Journal
# ==============================================================================

# Server Runtime Configuration
PORT=8080
NODE_ENV=production

# Google Cloud Project Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCP_PROJECT=your-gcp-project-id

# Gemini API Configuration (Retrieved from Google Cloud Secret Manager or Env Var)
# Directives strictly forbid hardcoded keys in source code.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Firebase Client Configuration (Optional for Google Sign-In on Web)
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=1234567890
FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Optional: Firebase Admin Service Account Key (JSON string, if not using Cloud Run ADC)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Development Switch: Set to true for automated test runner execution
ALLOW_DEV_AUTH=true
